{
    "semi": false,
    "singleQuote": true,
    "tabWidth": 4,
    "printWidth": 120,
    "bracketSpacing": true,
    "jsxSingleQuote": true,
    "vueIndentScriptAndStyle": true,
    "trailingComma": "none",
    "htmlWhitespaceSensitivity": "ignore",
    "singleAttributePerLine": true,
    "endOfLine": "auto",
    "overrides": [
        {
            "files": "**/*.scss",
            "options": {
                "parser": "scss"
            }
        }
    ]
}
